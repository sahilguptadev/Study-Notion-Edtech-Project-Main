# Frontend (Create React App). Copy to .env: `cp .env.example .env`
# Backend base URL (see backend/README.md to run the API)
REACT_APP_BASE_URL=http://localhost:4000/api/v1
# Razorpay *Key ID* only (never put the secret here)
REACT_APP_RAZORPAY_KEY=
# Skips CRA's ESLint plugin, which fails on some fresh installs
DISABLE_ESLINT_PLUGIN=true
